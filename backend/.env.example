# --- Server ---
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173

# --- Postgres ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/crash_demo

# --- Telegram ---
# Get this from @BotFather when you create your bot.
TELEGRAM_BOT_TOKEN=123456789:REPLACE_WITH_YOUR_BOT_TOKEN

# How long a Telegram initData payload is considered valid, in seconds.
TELEGRAM_AUTH_MAX_AGE=86400

# --- Game economy (DEMO / VIRTUAL COINS ONLY — no real value) ---
# Starting balance given to every new player, in virtual coins.
STARTING_BALANCE=1000
# House edge baked into the provably-fair crash formula (as a fraction, e.g. 0.01 = 1%).
HOUSE_EDGE=0.01
# Betting window before each round starts, in milliseconds.
BETTING_WINDOW_MS=5000
# How often the multiplier ticks, in milliseconds.
TICK_INTERVAL_MS=100
# Growth rate constant used in the multiplier curve (higher = faster climb).
GROWTH_RATE=0.00006
